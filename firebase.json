{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, max-age=0, must-revalidate" }
        ]
      }
    ],
    "redirects": [
      { "source": "/nl-BE", "destination": "/", "type": 301 },
      { "source": "/en-BE", "destination": "/en", "type": 301 }
    ]
  }
}
