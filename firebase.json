{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      { "source": "/nl-BE", "destination": "/", "type": 301 },
      { "source": "/en-BE", "destination": "/en", "type": 301 }
    ]
  }
}
